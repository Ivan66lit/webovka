@{
    ViewData["Title"] = "Home Page";
}

<div class="offer">
    <img src="images/house.png" class="house">
    <div class="offer-text">
        <h3>Samozřejmě si zasloužíte <br> nejlepší cenu pro <br> vaše bydlení.</h3>
        <p>Mějte jistotu v každém dni se střechou nad hlavou.</p>
        <a href="#" class="button">Více informací</a>
    </div>
</div>
<div class="services">
    <div class="grid">
        <div class="box">
            <h4>Koupě</h4>
            <ul>
                <li>Byt</li>
                <li>Dům</li>
                <li>Pozemek</li>
                <li>Komerční prostor</li>
                <li>Investiční byt</li>
            </ul>
        </div>
        <div class="box">
            <h4>Řízení</h4>
            <ul>
                <li>Správa komerčních nemovitostí</li>
                <li>Pomoc během jednacího procesu</li>
                <li>Hledání potenciálních nájemců/kupujících</li>
            </ul>
        </div>
        <div class="box">
            <h4>Investice</h4>
            <ul>
                <li>Schůzka s finančním poradcem</li>
                <li>Obecný přehled</li>
                <li>Blog</li>
            </ul>
        </div>
    </div>
</div>
<div class="advantages">
    <h5>Proč zvolit Anarion?</h5>
    <div class="gallery">
        <div class="card">
            <img src="images/glass.png">
            <p>Jednoduché vyhledávání</p>
        </div>
        <div class="card">
            <img src="images/save.png">
            <p>Úspora</p>
        </div>
        <div class="card">
            <img src="images/pointer.png">
            <p>Široká nabídka</p>
        </div>
        <div class="card">
            <img src="images/graf.png">
            <p>Zodpovědné investice</p>
        </div>
        <div class="card">
            <img src="images/unknown.png">
            <p>Jistota v majetku</p>
        </div>
    </div>
</div>