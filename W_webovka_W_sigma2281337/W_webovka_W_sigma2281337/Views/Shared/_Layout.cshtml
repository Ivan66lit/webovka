<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - W_webovka_W_sigma2281337</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/W_webovka_W_sigma2281337.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="logo">
            <img src="images/logo.png">
            <div class="name">
                <h1>ANARION</h1>
                <h2>& Co</h2>
            </div>
        </div>
        <div class="separator"></div>
        <nav class="menu">
            <ul>
                <li><a href="#">Prodej</a></li>
                <li><a href="#">Pronájem</a></li>
                <li><a href="investments.html">Investice</a></li>
                <li><a href="services.html">Služby</a></li>
                <li><a href="about-us.html" class="active">O nás</a></li>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="footer-column">
            <ul>
                <li>Prodat</li>
                <li>Koupit</li>
                <li>Pronájem</li>
            </ul>
        </div>

        <div class="separator"></div>

        <div class="footer-column">
            <h4>Služby</h4>
            <ul>
                <li>Správa prostoru/bytu</li>
                <li>Hledání kupujícího/nájemce</li>
                <li>Jednací proces</li>
            </ul>
        </div>

        <div class="separator"></div>

        <div class="footer-column">
            <ul>
                <li><i class="bi bi-envelope"></i> info@anarion.cz</li>
                <li><i class="bi bi-telephone"></i> +420 123 456 789</li>
                <li><i class="bi bi-instagram"></i> anarion_realestate</li>
            </ul>
        </div>
        <div class="container">
            &copy; 2026 - W_webovka_W_sigma2281337 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
